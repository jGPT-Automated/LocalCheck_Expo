{
  "expo": {
    "name": "LocalCheck",
    "slug": "localcheck",
    "owner": "agenticjess-os",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localcheck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/auth-graphic.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.realjess.localcheck",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "LocalCheck uses your location to find courts near you and show who's playing nearby."
      }
    },
    "android": {
      "package": "com.realjess.localcheck"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalCheck uses your location to find courts near you and show who's playing nearby."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9c906173-0258-45a9-a3fe-786cda373c66"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9c906173-0258-45a9-a3fe-786cda373c66"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
