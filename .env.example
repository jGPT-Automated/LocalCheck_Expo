# Copy this file to .env.local for local development. Only publishable client values
# belong here. Never add Supabase secret/service-role keys or Mapbox download
# tokens to EXPO_PUBLIC_* variables.

# Required: Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Required for the map: Mapbox public token (pk.*)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Native EAS builds also require RNMAPBOX_MAPS_DOWNLOAD_TOKEN (sk.*) in the
# EAS environment. It is a build secret and must never be stored in .env.
