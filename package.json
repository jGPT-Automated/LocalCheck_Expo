{
  "name": "localcheck",
  "version": "1.0.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "preview:web": "./scripts/start-web-preview.sh",
    "export:web": "EXPO_NO_CACHE=1 expo export --clear --platform web",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:backend && pnpm run test:add-court && pnpm run test:court-discovery && pnpm run test:leaderboard && pnpm run test:feed && pnpm run test:brand && pnpm run test:notification-routes && pnpm run test:realtime && pnpm run test:home-presentation && pnpm run test:player-identity && pnpm run test:schedule",
    "test:backend": "node --no-warnings --experimental-strip-types --test supabase/functions/verify-court/courtVerification.test.mts supabase/functions/send-notification/pushDelivery.test.mts && node --test supabase/tests/source/backendContract.test.mjs",
    "test:add-court": "node --no-warnings --experimental-strip-types --test components/addCourtModel.test.mts",
    "test:court-discovery": "node --no-warnings --experimental-strip-types --test services/courtDiscoveryModel.test.mts",
    "test:leaderboard": "node --no-warnings --experimental-strip-types --test services/leaderboardFilter.test.mts",
    "test:feed": "node --no-warnings --experimental-strip-types --test services/feedModel.test.mts",
    "test:brand": "node --no-warnings --experimental-strip-types --test components/brand/logoPresentation.test.mts components/onboarding/splashTimeline.test.mts",
    "test:notification-routes": "node --no-warnings --experimental-strip-types --test lib/notificationRoutes.test.mts services/pushRegistrationPolicy.test.mts",
    "test:home-presentation": "node --no-warnings --experimental-strip-types --test components/home/homePresentation.test.mts",
    "test:player-identity": "node --no-warnings --experimental-strip-types --test components/ui/playerIdentity.test.mts",
    "test:schedule": "node --no-warnings --experimental-strip-types --test components/schedule/scheduleModel.test.mts",
    "test:realtime": "node --no-warnings --experimental-strip-types --test lib/realtimeHub.test.mts",
    "check:design": "node scripts/check-design-consistency.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run check:design",
    "check:release": "pnpm run check && ./scripts/start-web-preview.sh --export-only",
    "doctor": "./scripts/doctor.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@rnmapbox/maps": "10.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.11",
    "expo-apple-authentication": "^57.0.1",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "^57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "mapbox-gl": "^2.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-keyboard-controller": "1.22.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "54.0.10",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
