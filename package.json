{
  "name": "localcheck",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "preview:web": "./scripts/start-web-preview.sh",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:realtime",
    "test:realtime": "node --no-warnings --experimental-strip-types --test lib/realtimeHub.test.mts",
    "check": "pnpm run typecheck && pnpm run test",
    "check:release": "pnpm run check && expo export --platform web --output-dir /tmp/localcheck-release-export",
    "doctor": "./scripts/doctor.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@rnmapbox/maps": "10.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~54.0.36",
    "expo-apple-authentication": "^8.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-crypto": "^15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "mapbox-gl": "^2.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "54.0.10",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
